# ==============================================================================
# Gurukul DeepEval Benchmark Suite Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OpenAI-Compatible Model Configuration
# ------------------------------------------------------------------------------
# Switch effortlessly between OpenAI, vLLM, Ollama, LM Studio, Groq, Together, OpenRouter, etc.

# API Key (Required for OpenAI/Groq/OpenRouter/Together; use 'EMPTY' for local vLLM/Ollama/LMStudio)
OPENAI_API_KEY=your_openai_api_key_here

# Base URL for the OpenAI-compatible endpoint
# Examples:
#   - Official OpenAI:    https://api.openai.com/v1
#   - Local vLLM server:  http://localhost:8000/v1
#   - Local Ollama:       http://localhost:11434/v1
#   - Local LM Studio:    http://localhost:1234/v1
#   - OpenRouter:         https://openrouter.ai/api/v1
#   - Groq Cloud:         https://api.groq.com/openai/v1
#   - Together AI:        https://api.together.xyz/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Model ID to use for evaluation
# Examples:
#   - OpenAI:         gpt-4o-mini, gpt-4o
#   - Local / vLLM:   meta-llama/Llama-3.1-8B-Instruct, mistralai/Mistral-7B-Instruct-v0.3
#   - OpenRouter:     deepseek/deepseek-chat, google/gemini-flash-1.5
#   - Ollama:         llama3.1:8b, qwen2.5:7b
OPENAI_MODEL_ID=gpt-4o-mini

# ------------------------------------------------------------------------------
# 2. Alternative Providers & Direct Judge Selection
# ------------------------------------------------------------------------------
# Google Gemini API Key (if using native Gemini instead of OpenAI-compatible)
# GEMINI_API_KEY=your_gemini_api_key_here

# Active Judge Model override (uncomment only if different from OPENAI_MODEL_ID)
# BENCHMARK_JUDGE=gpt-4o-mini


# Ollama Endpoint (for native ollama models)
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# 3. Artifact Directory Path
# ------------------------------------------------------------------------------
GURUKUL_ARTIFACT_DIR=/home/mindmap/.gemini/antigravity/brain/9c1fac78-044a-407d-ac16-cbf96b100902

# ------------------------------------------------------------------------------
# 4. G-Eval Metric Scoring Thresholds (0.0 to 1.0)
# ------------------------------------------------------------------------------
BENCHMARK_THRESHOLD_LANG=0.8
BENCHMARK_THRESHOLD_OFFER=0.8
BENCHMARK_THRESHOLD_GROUNDING=0.7
BENCHMARK_THRESHOLD_ABSTENTION=0.7
